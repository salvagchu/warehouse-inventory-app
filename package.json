{
  "name": "almacen-inventario",
  "version": "1.0.4",
  "description": "App de inventario de almacen con base de datos en la nube",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "release": "vite build && electron-builder --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tuempresa.almaceninventario",
    "productName": "Warehouse Inventory",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "salvagchu",
      "repo": "warehouse-inventory-app"
    },
    "files": ["dist/**/*", "electron/**/*"],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}